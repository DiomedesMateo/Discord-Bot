# ── Cache de canales de ticket ────────────────────────────────────────────────
# FIX 4: evita un SELECT por cada mensaje en cualquier canal del servidor.
# Mapea channel_id → ticket_id | None. Se invalida en apertura/cierre.
_ticket_channel_cache: dict[int, int | None] = {}

# ── Helper compartido de formateo ─────────────────────────────────────────────
# FIX 12: única definición, usada tanto en _close_ticket como en
# _build_dm_transcript_text (antes estaba duplicada en ambos sitios).
def _fmt_member_name(guild: discord.Guild, uid: int) -> str:
    m = guild.get_member(uid)
    return str(m) if m else f"Usuario ({uid})"


