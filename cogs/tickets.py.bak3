class TiendaModal(discord.ui.Modal, title="🛒 Ticket de Tienda"):
    nick     = discord.ui.TextInput(label="Nick", placeholder="Ej: Steve123", max_length=32)
    bedrock  = discord.ui.TextInput(label="¿Eres de Bedrock?", placeholder="Sí / No", max_length=5)
    modalidad = discord.ui.TextInput(label="Modalidad", placeholder="Ej: Survival, Skyblock, Anarchy…", max_length=60)
    tebex_id = discord.ui.TextInput(label="Tebex ID", placeholder="ID de tu compra en Tebex", max_length=60)
    problema = discord.ui.TextInput(
        label="Describe tu problema",
        placeholder="Cuéntanos qué ocurrió con tu compra…",
        style=discord.TextStyle.paragraph,
        max_length=500,
    )

    async def on_submit(self, interaction: discord.Interaction):
        # FIX 1: send_message() es la única respuesta válida para un modal submit.
        await interaction.response.send_message("⏳ Creando tu ticket…", ephemeral=True)
        await _open_ticket(interaction, "tienda", [
            ("Nick", self.nick.value),
            ("¿Eres de Bedrock?", self.bedrock.value),
            ("Modalidad", self.modalidad.value),
            ("Tebex ID", self.tebex_id.value),
            ("Describe tu problema", self.problema.value),
        ])


